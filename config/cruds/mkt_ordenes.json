{
  "resource": {
    "key": "mkt_ordenes",
    "title": "Órdenes de membresía",
    "table": "dom_mkt_ordenes",
    "primary_key": "id",
    "permission_prefix": "marketing"
  },
  "security": { "allow_core_table": false, "mode": "restricted" },
  "list": {
    "columns": [
      { "name": "public_id", "label": "Referencia", "searchable": true, "sortable": true },
      { "name": "paquete_slug", "label": "Plan", "sortable": true },
      { "name": "ciclo", "label": "Ciclo", "badge": { "monthly": "info", "annual": "primary" } },
      { "name": "nombre", "label": "Nombre", "searchable": true },
      { "name": "email", "label": "Correo", "searchable": true },
      { "name": "status", "label": "Estado", "badge": {
        "pending_transfer": "warning", "awaiting_review": "info", "paid": "success",
        "rejected": "danger", "cancelled": "secondary"
      } },
      { "name": "api_tenant_public_id", "label": "Tenant API", "format": "truncate", "max_length": 26 },
      { "name": "created_at", "label": "Creada", "format": "datetime", "sortable": true }
    ],
    "filters": [ { "field": "status", "label": "Estado" } ],
    "actions": ["show", "edit"]
  },
  "form": {
    "fields": [
      { "name": "api_tenant_public_id", "label": "Tenant API (public id)", "type": "text", "col": "col-md-6",
        "help": "Asociar tenant demo del lead antes de autorizar pago." },
      { "name": "status", "label": "Estado", "type": "select", "col": "col-md-6",
        "options": {
          "pending_transfer": "Transferencia pendiente",
          "awaiting_review": "En revisión",
          "paid": "Pagada",
          "rejected": "Rechazada",
          "cancelled": "Cancelada"
        } }
    ],
    "validators": []
  },
  "actions": { "row": [
      { "name": "show", "type": "builtin" },
      { "name": "edit", "type": "builtin" },
      { "name": "autorizar_pago", "type": "link", "label": "Autorizar pago", "icon": "bi-check-circle",
        "route": "/admin/marketing/ordenes/autorizar?orden_id={id}", "permission": "marketing.ordenes",
        "visible_when": { "status": ["pending_transfer", "awaiting_review"] } }
    ], "bulk": [] },
  "detail": { "tabs": [ { "key": "general", "label": "Datos", "type": "fields", "columns": [
      "public_id", "paquete_slug", "ciclo", "precio_snapshot", "mensajes_mes_limite_snapshot",
      "nombre", "email", "telefono", "empresa", "direccion", "rfc", "lead_id",
      "api_tenant_public_id", "status", "transfer_notified_at", "authorized_at", "authorized_by",
      "api_activation_error", "created_at"
    ] } ] },
  "uploads": { "enabled": false, "public_path": "uploads/cruds/mkt_ordenes" },
  "hooks": { "handler": null }
}
