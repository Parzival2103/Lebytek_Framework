{
    "name": "lebytek/skeleton",
    "description": "Esqueleto minimo de aplicacion Lebytek (consume lebytek/framework)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "lebytek/framework": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
