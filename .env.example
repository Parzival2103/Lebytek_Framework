# =============================================
# ENTORNO DE APLICACIÓN
# =============================================
APP_ENV=local
APP_DEBUG=true
APP_NAME="Lebytek"
# URL base pública (sin barra final). Debe coincidir con cómo accedes al sitio.
# Producción: document root en public/ → https://lebytek.com (nunca .../public).
# Local: p. ej. http://localhost:8000 si corres: php -S localhost:8000 -t public
# Usado en CTAs de correo (credenciales: Ver paquetes → APP_URL/?compras=1#paquetes).
APP_URL=http://localhost:8000
APP_KEY=cambiar_por_clave_aleatoria_de_32_chars
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_ASSET_VERSION=1

# =============================================
# BASE DE DATOS
# =============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lebytek_db
DB_USERNAME=root
DB_PASSWORD=

# =============================================
# SESIÓN
# =============================================
SESSION_LIFETIME=120
SESSION_REMEMBER_LIFETIME=43200
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

# =============================================
# ALMACENAMIENTO
# =============================================
STORAGE_PATH=storage
MAX_UPLOAD_MB=10

# =============================================
# CORREO
# =============================================
MAIL_DRIVER=log
MAIL_HOST=mail.tudominio.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_TIMEOUT=15
MAIL_USERNAME=cuenta@tudominio.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=cuenta@tudominio.com
MAIL_FROM_NAME="Lebytek"

# Variables de negocio Portal (Marketing, Lebytek API client, panel waapi):
# definir en Parzival2103/Lebytek_Portal — .env.example
# No duplicar MKT_*, LEBYTEK_API_* ni WAAPI_PORTAL_* en el harness del package source.

REGISTRO_HABILITADO=false
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15

# =============================================
# SEGURIDAD
# =============================================
BCRYPT_ROUNDS=12
CSRF_TOKEN_LENGTH=32
# Token para el wizard /install/ cuando APP_ENV=production (ver docs/core/despliegue-y-versionado.md)
INSTALL_TOKEN=

# ── Integraciones locales (legacy / demo; Fase 2 usa api) ──
GREEN_API_ENABLED=false
GREEN_API_BASE_URL=https://api.green-api.com
GREEN_API_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_TIMEOUT=15
GREEN_API_WEBHOOK_TOKEN=
GREEN_API_PARTNER_TOKEN=
# Comma-separated E.164-ish digits. Requires GREEN_API_ENABLED=true + GREEN_API_INSTANCE/TOKEN.
INTEGRATIONS_API_DOCS_URL=/docs/integraciones/whatsapp-api

# Pagos (plataforma — OFF por defecto)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_CURRENCY=mxn
PAYMENTS_DEFAULT_GATEWAY=stripe

# Facturación (plataforma — OFF por defecto)
FACTURAPI_ENABLED=false
FACTURAPI_SECRET_KEY=
FACTURAPI_MODE=test
INVOICING_DEFAULT_PROVIDER=facturapi
